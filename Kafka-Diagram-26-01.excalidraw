    {
      "id": "thPQTs3uU-qmqPXeZCCJ6",
      "type": "text",
      "x": 439.23536809239937,
      "y": 3853.215478416883,
      "width": 255.36666870117188,
      "height": 223.09909019707277,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
