      "groupIds": [],
      "frameId": null,
      "index": "bfD",
      "roundness": null,
      "seed": 423374882,
      "version": 582,
      "versionNonce": 674258878,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769463300112,
      "link": null,
      "locked": false,
      "text": "services:\n\n  zookeeper:\n    image: confluentinc/cp-zookeeper:7.7.7\n    environment:\n      ZOOKEEPER_CLIENT_PORT: 2181\n      ZOOKEEPER_TICK_TIME: 2000\n\n\n  kafka:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_BROKER_ID: 1\n      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092\n      KAFKA_LOG_DIRS: /var/lib/kafka/data",
      "fontSize": 9.9155151198699,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "services:\n\n  zookeeper:\n    image: confluentinc/cp-zookeeper:7.7.7\n    environment:\n      ZOOKEEPER_CLIENT_PORT: 2181\n      ZOOKEEPER_TICK_TIME: 2000\n\n\n  kafka:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_BROKER_ID: 1\n      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092\n      KAFKA_LOG_DIRS: /var/lib/kafka/data",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "slAq0M8AImUr36CsnfmQh",
      "type": "text",
      "x": 741.8073286642796,
      "y": 3852.902239365723,
      "width": 396.6333312988281,
      "height": 347.0430291954465,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
