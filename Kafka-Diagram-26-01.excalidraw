      "seed": 1443020258,
      "version": 467,
      "versionNonce": 1335749858,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769463258323,
      "link": null,
      "locked": false,
      "text": "services:\n\n  kafka1:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_KRAFT_MODE: 'true'\n      CLUSTER_ID: '1L6g7nGhU-eAKfL--X25wo'\n      KAFKA_NODE_ID: 1 (brokerID)\n      KAFKA_PROCESS_ROLES: broker,controller\n      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka1:9093,2@kafka2:9093\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093\n      KAFKA_LOG_DIRS: /tmp/kraft-combined-logs\n\n\n  kafka2:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_KRAFT_MODE: 'true'\n      CLUSTER_ID: '1L6g7nGhU-eAKfL--X25wo'\n      KAFKA_NODE_ID: 2 (brokerID)\n      KAFKA_PROCESS_ROLES: broker,controller\n      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka1:9093,2@kafka2:9093\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093\n      KAFKA_LOG_DIRS: /tmp/kraft-combined-logs",
      "fontSize": 9.9155151198699,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "services:\n\n  kafka1:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_KRAFT_MODE: 'true'\n      CLUSTER_ID: '1L6g7nGhU-eAKfL--X25wo'\n      KAFKA_NODE_ID: 1 (brokerID)\n      KAFKA_PROCESS_ROLES: broker,controller\n      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka1:9093,2@kafka2:9093\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093\n      KAFKA_LOG_DIRS: /tmp/kraft-combined-logs\n\n\n  kafka2:\n    image: confluentinc/cp-kafka:7.7.7\n    environment:\n      KAFKA_KRAFT_MODE: 'true'\n      CLUSTER_ID: '1L6g7nGhU-eAKfL--X25wo'\n      KAFKA_NODE_ID: 2 (brokerID)\n      KAFKA_PROCESS_ROLES: broker,controller\n      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka1:9093,2@kafka2:9093\n\n      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2\n      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093\n      KAFKA_LOG_DIRS: /tmp/kraft-combined-logs",
      "autoResize": true,
      "lineHeight": 1.25
    },
