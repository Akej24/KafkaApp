      "link": null,
      "locked": false,
      "text": "The Group Coordinator uses internal compacted\n'__consumer_offsets' topic to keep track of group metadata.\n\nYou can think about it as a bookmark to indicate where a\nconsumer should resume reading from.\n\nExamples:\n[group1, topic-events, partition-0, offset-10]\n[group2, topic-events, partition-2, offset-34] \n",
      "fontSize": 15.881154318695467,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Group Coordinator uses internal compacted '__consumer_offsets' topic to keep track of group metadata.\n\nYou can think about it as a bookmark to indicate where a consumer should resume reading from.\n\nExamples:\n[group1, topic-events, partition-0, offset-10]\n[group2, topic-events, partition-2, offset-34] \n",
      "autoResize": false,
      "lineHeight": 1.25
    },
